# Normalize to LF in the repo; check out native on Windows where it matters.
* text=auto eol=lf

# Windows script hosts require CRLF. A LF-only .cmd or .ps1 misbehaves.
*.cmd  text eol=crlf
*.bat  text eol=crlf
*.ps1  text eol=crlf

# POSIX shells choke on CRLF: `\r` becomes part of the command.
*.sh   text eol=lf

# Never touch these.
*.png  binary
*.jpg  binary
*.ico  binary
*.icns binary
*.pdf  binary
