{
  "name": "@cuesheet/cli",
  "version": "0.1.0-alpha",
  "private": true,
  "description": "The cuesheet command-line client.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "cuesheet": "./dist/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"import('node:fs').then(m=>process.platform!=='win32'&&m.chmodSync('dist/main.js',0o755))\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"import('node:fs').then(m=>m.rmSync('dist',{recursive:true,force:true}))\""
  },
  "dependencies": {
    "@cuesheet/core": "*"
  },
  "devDependencies": {
    "@cuesheet/daemon": "*"
  }
}
