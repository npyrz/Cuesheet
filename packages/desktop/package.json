{
  "name": "@cuesheet/desktop",
  "version": "0.0.0",
  "private": true,
  "description": "Electron shell. CommonJS on purpose - see PLAN-STEP.MD Phase 5.",
  "main": "./dist/main.cjs",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "node build.mjs --dev && electron .",
    "start": "electron .",
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"import('node:fs').then(m=>m.rmSync('dist',{recursive:true,force:true}))\""
  },
  "dependencies": {
    "@cuesheet/core": "*",
    "@cuesheet/daemon": "*",
    "@cuesheet/ui": "*"
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "esbuild": "^0.28.2"
  }
}
