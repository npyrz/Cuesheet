{
  "name": "@cuesheet/daemon",
  "version": "0.1.0-alpha",
  "private": true,
  "description": "cuesheetd - the daemon. HTTP + WebSocket, queue, run store.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "cuesheetd": "./dist/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"import('node:fs').then(m=>process.platform!=='win32'&&m.chmodSync('dist/main.js',0o755))\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"import('node:fs').then(m=>m.rmSync('dist',{recursive:true,force:true}))\""
  },
  "dependencies": {
    "@cuesheet/core": "*",
    "@cuesheet/harness": "*",
    "@fastify/websocket": "^11.3.0",
    "fastify": "^5.12.3"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "ws": "^8.21.3"
  }
}
