{
  "name": "@cuesheet/ui",
  "version": "0.0.0",
  "private": true,
  "description": "The Desk - React UI, served by the daemon and loaded by the desktop shell.",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"import('node:fs').then(m=>m.rmSync('dist',{recursive:true,force:true}))\""
  },
  "dependencies": {
    "@cuesheet/core": "*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.1.0",
    "vite": "^8.3.0"
  }
}
